{
  "permissions": {
    "allow": [
      "Bash(./scripts/check)",
      "Bash(./scripts/dev:*)",
      "Bash(./scripts/setup)",
      "Bash(./scripts/test:*)",
      "Bash(swift scripts/arch.swift)",
      "Bash(./scripts/bundle:*)",
      "Bash(./scripts/fixtures:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift format lint:*)",
      "Bash(swift format format:*)",
      "Bash(swift package dump-package)",
      "Bash(swift package describe:*)",
      "Bash(swift package resolve)"
    ],
    "deny": [
      "Bash(op read:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)"
    ]
  }
}
