#!/usr/bin/env bash
# Get a clean checkout to a runnable state. Must be idempotent.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x scripts/*

# Swift Testing needs full Xcode; the Command Line Tools alone can't build the tests.
if ! xcodebuild -version >/dev/null 2>&1; then
  printf '\033[31m✗ Xcode is not the active developer directory.\033[0m\n' >&2
  printf '  Install Xcode %s, then: sudo xcode-select -s /Applications/Xcode.app\n' "$(cat .xcode-version)" >&2
  exit 1
fi

ln -sf ../../scripts/commit-msg .git/hooks/commit-msg
ln -sf ../../scripts/post-merge .git/hooks/post-merge

swift package resolve

echo "✓ setup complete"
