#!/usr/bin/env bash
# Update this checkout to the latest commit, then build and run the app. For a second Mac, such as
# the one the DAC is attached to, whose clone tracks the build Mac. Building needs only the
# Command Line Tools. Extra args go to the app:
#   ./scripts/pull --list-devices
set -euo pipefail
cd "$(dirname "$0")/.."

git pull --ff-only
exec ./scripts/dev "$@"
