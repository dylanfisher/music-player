#!/usr/bin/env bash
# Run the tests.
#   ./scripts/test                  the suite, minus the test targets whose inputs match the last
#                                   passing run: only what the edits since then can affect, and
#                                   nothing when there are none (ADR 0122). --fresh runs it all.
#   ./scripts/test --changed [ref]  only the test targets the files changed since ref (default
#                                   HEAD) can affect, uncommitted and untracked files included.
#                                   A pass that covers every target the plain form would run
#                                   updates its stamp, so the plain form then skips them.
#   ./scripts/test <args>           passes args to `swift test`, e.g. --filter RingBufferTests
#
# scripts/affected.swift says which paths a test reads and which test targets a changed path
# affects. `--changed` is the inner loop; ./scripts/check runs the plain form.
#
# Every form but the last runs each test target's bundle itself, TEST_JOBS at a time (default:
# the performance cores), with every window clear (scripts/clear-windows.m). `swift test` runs
# the bundles one after another (ADR 0182). A target's output goes to .build/test-logs.
set -euo pipefail
cd "$(dirname "$0")/.."

stamp=.build/test-pass
logs=.build/test-logs
# Each target's seconds in its last run, so the longest start first.
durations=.build/test-durations

fresh=0 changed=0 ref=HEAD args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --fresh) fresh=1 ;;
    --changed)
      changed=1
      if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then ref="$2"; shift; fi
      ;;
    *) args+=("$1") ;;
  esac
  shift
done

# swift_test <args> — swift test, failing also when a test process started a run and never
# printed its summary: one that exits 0 partway through otherwise passes (ADR 0127).
swift_test() {
  local log status=0 started ended
  log=$(mktemp)
  swift test "$@" 2>&1 | tee "$log" || status=$?
  started=$(grep -c '^◇ Test run started\.$' "$log" || true)
  ended=$(grep -cE '^[✔✘] Test run with ' "$log" || true)
  rm -f "$log"
  if [ "$started" != "$ended" ]; then
    echo "$((started - ended)) of $started test runs ended without a summary: a test process exited partway through" >&2
    return 1
  fi
  return "$status"
}

if [ "${#args[@]}" -gt 0 ]; then swift_test "${args[@]}"; exit; fi

# test_target <test target> — runs the target's bundle with the helper `swift test` uses, its
# output in its log, and prints one line saying how it went. It fails when the process does, or
# when the process started a run and never printed its summary (ADR 0127). Run by xargs, so it
# reads its settings from exported variables.
test_target() {
  local target=$1 start=$SECONDS status=0 executable log started ended summary
  executable=$bin/$target.xctest/Contents/MacOS/$target
  log=$logs/$target.log
  # Set here rather than exported: /usr/bin/xargs is protected by SIP, which drops DYLD_ variables
  # from what it runs.
  DYLD_INSERT_LIBRARIES=$clear DYLD_FRAMEWORK_PATH=$platform/Library/Frameworks \
    DYLD_LIBRARY_PATH=$platform/usr/lib NO_COLOR=1 \
    "$helper" --test-bundle-path "$executable" "$executable" --testing-library swift-testing \
    >"$log" 2>&1 || status=$?
  echo "$((SECONDS - start)) $target" >>"$logs/durations"
  started=$(grep -c '^◇ Test run started\.$' "$log" || true)
  ended=$(grep -cE '^[✔✘] Test run with ' "$log" || true)
  summary=$(grep -E '^[✔✘] Test run with ' "$log" | sed -E 's/^[✔✘] Test run with //' || true)
  if [ "$status" = 0 ] && [ "$started" = 1 ] && [ "$ended" = 1 ]; then
    echo "✔ $target: $summary"
    return 0
  fi
  if [ "$started" != 1 ] || [ "$ended" != 1 ]; then
    echo "✘ $target: the test process exited partway through, with status $status"
  else
    echo "✘ $target: $summary"
  fi
  touch "$logs/$target.failed"
}

# test_targets <test targets, one per line> — builds the tests, then runs each target's bundle,
# TEST_JOBS at a time, the longest in its last run first. Prints each failing target's issues
# once all have run.
test_targets() {
  # The helper runs Swift Testing's tests only, so an XCTest case would never run.
  if git grep --untracked -lq '^import XCTest' -- Tests; then
    echo "XCTest tests, which scripts/test doesn't run: $(git grep --untracked -l '^import XCTest' -- Tests)" >&2
    return 1
  fi
  swift build --build-tests
  bin=$(swift build --build-tests --show-bin-path)
  helper=$(dirname "$(xcrun --find swift)")/../libexec/swift/pm/swiftpm-testing-helper
  if [ ! -x "$helper" ]; then echo "no Swift Testing helper at $helper" >&2; return 1; fi
  platform=$(xcrun --show-sdk-platform-path)/Developer
  clear=.build/clear-windows.dylib
  if [ ! -e "$clear" ] || [ scripts/clear-windows.m -nt "$clear" ]; then
    clang -dynamiclib -fobjc-arc -framework AppKit -o "$clear" scripts/clear-windows.m
  fi
  export bin helper platform clear logs
  export -f test_target
  rm -rf "$logs"
  mkdir -p "$logs"
  # An Intel Mac has no performance cores to count.
  local jobs=${TEST_JOBS:-$(sysctl -n hw.perflevel0.physicalcpu 2>/dev/null || sysctl -n hw.physicalcpu)}
  local start=$SECONDS failed
  echo "running $(wc -l <<<"$1" | tr -d ' ') test targets, $jobs at a time"
  touch "$durations"
  # A target with no time yet sorts as 0 seconds, after the timed ones.
  awk 'FILENAME == ARGV[1] { seconds[$2] = $1; next } { print seconds[$0] + 0, $0 }' \
    "$durations" <(printf '%s\n' "$1") | sort -rn | cut -d' ' -f2 |
    xargs -P "$jobs" -n 1 bash -c 'test_target "$0"'
  # This run's times, and the last run's for the targets this one skipped.
  awk '{ seconds[$2] = $1 } END { for (t in seconds) print seconds[t], t }' \
    "$durations" "$logs/durations" >"$durations.new"
  mv "$durations.new" "$durations"
  failed=$(find "$logs" -name '*.failed' -exec basename {} .failed \; | sort)
  for target in $failed; do
    printf '\n\033[1m%s\033[0m (%s)\n' "$target" "$logs/$target.log"
    # Each issue with the values under it, or the end of the log when the process died.
    awk '/^✘ / { shown = 1; print; next } /^↳ / && shown { print; next } { shown = 0 }' \
      "$logs/$target.log" | grep . || tail -20 "$logs/$target.log"
  done
  echo "$((SECONDS - start)) s"
  if [ -n "$failed" ]; then
    echo "failed: $(tr '\n' ' ' <<<"$failed")" >&2
    return 1
  fi
}

# run <test targets, one per line, or `all`> — the bundles of just those targets.
run() {
  case "$1" in
    "") echo "no test reads what changed — skipped" ;;
    # Every file under Tests affects its own target, so this lists every test target.
    all) test_targets "$(git ls-files --cached --others --exclude-standard Tests | swift scripts/affected.swift)" ;;
    *) test_targets "$1" ;;
  esac
}

# The toolchain on the first line, then one `<sha>  <path>` line per input that exists, sorted
# for comm.
inputs() {
  printf 'toolchain %s\n' "$(swift --version 2>&1 | shasum | cut -c1-40)"
  swift scripts/affected.swift --inputs | tr '\n' '\0' |
    xargs -0 git ls-files --cached --others --exclude-standard -z -- |
    while IFS= read -r -d '' f; do if [ -e "$f" ]; then printf '%s\0' "$f"; fi; done |
    xargs -0 shasum | LC_ALL=C sort
}

# stale <inputs> — the test targets the edits since the last pass can affect: `all` with no
# stamp or a new toolchain, nothing when the inputs match it.
stale() {
  if [ ! -e "$stamp" ] || [ "$(head -1 "$stamp")" != "$(head -1 <<<"$1")" ]; then
    echo all
    return
  fi
  # Paths added, removed or edited since the last pass. shasum puts two spaces after the hash.
  local files
  files=$(LC_ALL=C comm -3 <(tail -n +2 "$stamp") <(tail -n +2 <<<"$1") |
    sed -E 's/^[[:space:]]*[0-9a-f]{40}  //' | sort -u)
  if [ -n "$files" ]; then swift scripts/affected.swift <<<"$files"; fi
}

# covers <targets run> <targets needed> — whether a pass over the first list covers the second.
covers() {
  [ -z "$2" ] || [ "$1" = all ] ||
    { [ "$2" != all ] && [ -z "$(LC_ALL=C comm -13 <(sort <<<"$1") <(sort <<<"$2"))" ]; }
}

current=$(inputs)

if [ "$changed" = 1 ]; then
  files=$( { git diff --name-only "$ref"; git ls-files --others --exclude-standard; } | sort -u)
  targets=$(swift scripts/affected.swift <<<"$files")
  needed=$(stale "$current")
  run "$targets"
  # A pass over every target the stamp says is stale is as good as a plain pass, so the gate's
  # test step after it has nothing left to run (ADR 0171).
  if covers "$targets" "$needed"; then printf '%s\n' "$current" > "$stamp"; fi
  exit 0
fi

if [ "$fresh" = 1 ]; then targets=all; else targets=$(stale "$current"); fi
if [ -z "$targets" ]; then
  echo "inputs match the last passing run — skipped (--fresh runs it anyway)"
  exit 0
fi
run "$targets"
printf '%s\n' "$current" > "$stamp"
