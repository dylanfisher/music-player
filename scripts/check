#!/usr/bin/env bash
# The gate. Everything must pass before work is considered done.
# Keep this the ONLY command anyone — human or agent — needs to remember.
#
# Every step runs even if an earlier one fails, so one invocation reports every
# problem. Fixing four failures should cost one run, not four.
#
#   ./scripts/check                 every step: the full gate
#   ./scripts/check --changed [ref] the steps that read the files changed since ref (default
#                                   HEAD), uncommitted and untracked files included, and
#                                   `./scripts/test --changed ref` as the test step (AGENTS.md)
#   ./scripts/check <step>...       the named steps alone, such as the ones that just failed
#   ./scripts/check --which         the steps for the paths on standard input, for check-test
# `steps` below says which step reads which path. scripts/affected.swift says which tests do.
set -uo pipefail
cd "$(dirname "$0")/.."

# The scripts the format step lints beside Package.swift, Sources and Tests.
format_scripts=(scripts/affected.swift scripts/arch.swift scripts/dupes.swift scripts/surface.swift
  scripts/size.swift scripts/icon-mask.swift scripts/smb-copy-probe.swift)
# The files the residue step searches for scaffolding text.
residue_files=(README.md CLAUDE.md AGENTS.md scripts/setup scripts/dev scripts/test docs/map.md
  docs/principles.md docs/scaffold.md .github/workflows/check.yml .claude/commands/scaffold.md)

# steps — the steps that read the paths on standard input, one per line, or `all` for a path
# every step depends on. A deleted path also picks map and links, which check that the paths
# they name exist. The test step isn't picked: --changed always runs it, and it skips itself
# when no test reads what changed.
steps() {
  local p s
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || printf '%s\n' map links
    case "$p" in
      scripts/check | .xcode-version) echo all ;;
      AGENTS.md) echo agents.md ;;
      docs/map.md) echo map ;;
      Package.swift) printf '%s\n' format typecheck arch ;;
      Package.resolved) echo typecheck ;;
      .swift-format) echo format ;;
      Sources/*) printf '%s\n' typecheck arch dupes surface ;;
      Tests/*) echo typecheck ;;
      scripts/arch.swift | scripts/dupes.swift | scripts/surface.swift | scripts/size.swift)
        s=${p#scripts/}
        printf '%s\n' "${s%.swift}" "${s%.swift}-test"
        ;;
      scripts/dupes-allow.txt | scripts/surface-allow.txt | scripts/size-allow.txt) s=${p#scripts/} && echo "${s%-allow.txt}" ;;
      scripts/arch-test | scripts/dupes-test | scripts/surface-test | scripts/size-test | scripts/affected-test | scripts/check-test | scripts/post-merge-test)
        echo "${p#scripts/}"
        ;;
      scripts/affected.swift) echo affected-test ;;
      scripts/post-merge) echo post-merge-test ;;
      scripts/check-signature*) echo signature-test ;;
    esac
    case "$p" in *.md) echo links ;; Sources/*.swift | Tests/*.swift) echo format ;; esac
    case "$p" in Sources/*.swift) echo size ;; esac
    for s in "${format_scripts[@]}"; do if [ "$p" = "$s" ]; then echo format; fi; done
    for s in "${residue_files[@]}"; do if [ "$p" = "$s" ]; then echo residue; fi; done
  done | LC_ALL=C sort -u
}

failures=()
chosen=("$@")
ran=()
test_step=(./scripts/test)
case "${1-}" in
  --which) steps; exit ;;
  --changed)
    if [ $# -gt 2 ]; then echo "usage: ./scripts/check --changed [ref]" >&2; exit 2; fi
    ref="${2:-HEAD}"
    changed=$(git diff --no-renames --name-only "$ref") || exit 2
    picked=$( { printf '%s\n' "$changed"; git ls-files --others --exclude-standard; } | steps)
    test_step=(./scripts/test --changed "$ref")
    if grep -qx all <<<"$picked"; then
      chosen=()
    else
      # shellcheck disable=SC2206 # step names have no spaces
      chosen=($picked test)
    fi
    ;;
esac

# run <name> <command...> — print a header, run it, record the failure, continue. With steps
# named on the command line, any other step is skipped.
run() {
  local name="$1"; shift
  if [ ${#chosen[@]} -gt 0 ] && [[ " ${chosen[*]} " != *" $name "* ]]; then return; fi
  ran+=("$name")
  printf '\n\033[1m▸ %s\033[0m\n' "$name"
  if ! "$@"; then failures+=("$name"); fi
}

# AGENTS.md is the highest-leverage file in the repo and the easiest to let rot.
# These are the only rules about it a tool can check; the rest is judgment.
run agents.md bash -c '
  lines=$(wc -l < AGENTS.md | tr -d " ")
  if [ "$lines" -gt 55 ]; then
    echo "AGENTS.md is $lines lines (limit ~50). Move a section to docs/ and link it." >&2; exit 1
  fi
  if grep -q "{{" AGENTS.md; then echo "AGENTS.md has unfilled {{PLACEHOLDER}}s." >&2; exit 1; fi
  if grep -q "NOT YET INITIALIZED" AGENTS.md; then echo "AGENTS.md still has the TEMPLATE block." >&2; exit 1; fi
  echo "$lines lines, no placeholders"
'

# The code map claims where things live. Verify the claim — a rename that misses
# docs/map.md turns it into confident misdirection, which is worse than no map.
run map bash -c '
  if grep -q "{{" docs/map.md; then
    echo "docs/map.md has unfilled {{PLACEHOLDER}}s." >&2; exit 1
  fi
  paths=$(grep "^<!-- paths:" docs/map.md | sed "s/^<!-- paths: //; s/ -->//")
  if [ -z "$paths" ]; then
    echo "docs/map.md is missing its <!-- paths: ... --> line." >&2; exit 1
  fi
  missing=""
  for p in $paths; do [ -e "$p" ] || missing="$missing $p"; done
  if [ -n "$missing" ]; then
    echo "docs/map.md names paths that do not exist:$missing" >&2; exit 1
  fi
  echo "tiers exist: $paths"
'

# AGENTS.md stays small by linking instead of restating, so a dead link is not a
# cosmetic problem — it is the pointer to the real instruction going missing.
# `find` rather than `git ls-files` — an uncommitted clone would make the latter
# return nothing and pass silently, which is the failure this whole file exists
# to prevent. Prune dependency trees so the cost stays flat as the project grows.
run links bash -c '
  files=$(find . -name "*.md" -not -path "./.git/*" \
    -not -path "*/node_modules/*" -not -path "*/vendor/*" -not -path "*/.venv/*" \
    -not -path "*/dist/*" -not -path "*/build/*" -not -path "*/target/*")
  if [ -z "$files" ]; then echo "no markdown found — this check is not looking where it should." >&2; exit 1; fi
  bad=""
  for f in $files; do
    for link in $(grep -oE "\]\([^)]+\)" "$f" | sed "s/^](//; s/)$//"); do
      case "$link" in http*|mailto:*|\#*) continue ;; esac
      target="${link%%#*}"
      [ -z "$target" ] && continue
      [ -e "$(dirname "$f")/$target" ] || bad="$bad
    $f → $link"
    done
  done
  if [ -n "$bad" ]; then echo "markdown links point at nothing:$bad" >&2; exit 1; fi
  echo "all relative links resolve"
'

# Scaffolding is meant to be torn out, and a half-torn teardown reads as though
# the project were still a template. Dormant until docs/scaffold.md is gone, so
# it never fires on a fresh clone — which also means restoring that file switches
# the step back off. Keep it afterwards anyway: it costs one grep, and it catches
# scaffolding text reintroduced by a copied file or a reverted deletion.
# This file is excluded from the word search — it mentions the term by design —
# so its own leftover is caught by looking for the todo() helper instead.
run residue bash -c '
  if [ -e docs/scaffold.md ]; then echo "not scaffolded yet — skipped"; exit 0; fi
  bad=""
  for f in "$@"; do
    [ -e "$f" ] || continue
    grep -qi "scaffold" "$f" && bad="$bad $f"
  done
  # The workflow placeholder says "scaffold" nowhere, and leaving it in keeps CI
  # red forever with no local symptom — so match its text directly.
  if [ -e .github/workflows/check.yml ] && grep -q "no language setup step configured" .github/workflows/check.yml; then
    bad="$bad .github/workflows/check.yml(setup placeholder)"
  fi
  [ -e .claude/commands/scaffold.md ] && bad="$bad .claude/commands/scaffold.md"
  grep -q "^todo()" scripts/check && bad="$bad scripts/check(todo helper)"
  if [ -n "$bad" ]; then
    echo "scaffolding leftovers — see step 9 of the checklist:$bad" >&2; exit 1
  fi
  echo "no leftovers"
' residue "${residue_files[@]}"

# swift-format checks layout and its lint rules (.swift-format) in one pass.
run format    swift format lint --strict --recursive --parallel Package.swift Sources Tests "${format_scripts[@]}"
# Strict concurrency and warnings-as-errors are set in Package.swift, so a clean build is the typecheck.
run typecheck swift build --build-tests
run arch      swift scripts/arch.swift
run arch-test ./scripts/arch-test
# Each fact once and no third copy of a block (ADR 0024); the test plants one of each.
run dupes     swift scripts/dupes.swift
run dupes-test ./scripts/dupes-test
# Each public and package declaration has a caller outside its module (ADR 0030); the test
# plants each finding.
run surface   swift scripts/surface.swift
run surface-test ./scripts/surface-test
# No Swift file under Sources over 1,000 lines outside its allowlist, whose ceilings only go down
# (ADR 0201); the test plants each finding.
run size      swift scripts/size.swift
run size-test ./scripts/size-test
# The release signature check refuses what it should (ADR 0025), on stand-in bundles.
run signature-test ./scripts/check-signature-test
# The test step's own picker, on paths whose test targets are known.
run affected-test ./scripts/affected-test
# The --changed picker, on paths whose steps are known; and the hook that carries the test stamp.
run check-test ./scripts/check-test
run post-merge-test ./scripts/post-merge-test
run test      "${test_step[@]}"

for name in ${chosen[@]+"${chosen[@]}"}; do
  if [[ " ${ran[*]-} " != *" $name "* ]]; then failures+=("$name (no such step)"); fi
done

if [ ${#failures[@]} -gt 0 ]; then
  printf '\n\033[31m✗ failed: %s\033[0m\n' "${failures[*]}" >&2
  exit 1
fi

if [ ${#chosen[@]} -gt 0 ]; then
  printf '\n\033[32m✓ passed: %s (not the full gate)\033[0m\n' "${ran[*]}"
else
  printf '\n\033[32m✓ all checks passed\033[0m\n'
fi
