#!/usr/bin/env bash
# Mutation testing of the core state machines (ADR 0027). Not part of ./scripts/check.
#   ./scripts/mutate [--jobs <n>] [<part of a file path>]
# Lists the mutants of each entry in scripts/mutate-files.txt with scripts/mutate.swift, then
# runs them in git worktrees of HEAD under .build/mutate, one per job (3 by default, and no more
# than there are mutants): each job builds the entries' test targets and runs them unmutated,
# then for each mutant applies it, builds its entry's test targets, runs their bundles and
# checks the file out again. A mutant the tests fail on (twice: a failing run is run again),
# crash on or time out on is killed; one they pass survives; one that doesn't build isn't
# counted. The run refuses to score, and stops, when the unmutated tests fail or a mutant's
# tests never start, since then a failure says nothing about the mutant. The main checkout is
# never written. Results are in .build/mutate/results.tsv, and each file's score and survivors
# are printed. The worktrees are removed on exit; their builds are kept in
# .build/mutate/build-<n>, so a second run builds less.
set -euo pipefail
cd "$(dirname "$0")/.."
repo=$(pwd)

jobs=3
only=""
while [ $# -gt 0 ]; do
  case "$1" in
    --jobs)
      if [ $# -lt 2 ]; then echo "error: --jobs needs a number" >&2; exit 1; fi
      case "$2" in
        ''|*[!0-9]*|0) echo "error: --jobs needs a number above 0, not $2" >&2; exit 1 ;;
      esac
      jobs=$2
      shift 2 ;;
    --*) echo "error: $1 isn't an option" >&2; exit 1 ;;
    *)
      if [ -n "$only" ]; then echo "error: give one part of a path, not $only and $1" >&2; exit 1; fi
      only=$1
      shift ;;
  esac
done

out="$repo/.build/mutate"
mkdir -p "$out"
worktrees=()
pids=()
cleanup() {
  # Jobs still going, as on ^C: stop each, the builds and test runs under it, and any test
  # helper using its scratch path, before their worktrees go.
  for pid in "${pids[@]+"${pids[@]}"}"; do
    pkill -TERM -P "$pid" 2> /dev/null || true
    kill "$pid" 2> /dev/null || true
  done
  pkill -f "swift-(build|test|frontend).*$out/build-" 2> /dev/null || true
  pkill -f "swiftpm-testing-helper.*$out/build-" 2> /dev/null || true
  for pid in "${pids[@]+"${pids[@]}"}"; do wait "$pid" 2> /dev/null || true; done
  for tree in "${worktrees[@]+"${worktrees[@]}"}"; do
    git -C "$repo" worktree remove --force "$tree" 2> /dev/null || rm -rf "$tree"
  done
  git -C "$repo" worktree prune
}
trap cleanup EXIT
trap 'exit 130' INT TERM

tool="$out/mutate-tool"
swiftc -O -o "$tool" scripts/mutate.swift

# Every mutant: file, id, line, what changed, test target.
plan="$out/plan.tsv"
: > "$plan"
grep -v '^#' scripts/mutate-files.txt | grep -v '^ *$' | while read -r file lines target; do
  [ -z "$only" ] || [[ "$file" == *"$only"* ]] || continue
  [ -f "$file" ] || { echo "error: scripts/mutate-files.txt names $file, which doesn't exist" >&2; exit 1; }
  range=()
  [ "$lines" = all ] || range=("$lines")
  "$tool" list "$file" "${range[@]+"${range[@]}"}" \
    | awk -F'\t' -v file="$file" -v target="$target" '{ print file "\t" $1 "\t" $2 "\t" $3 "\t" target }'
done >> "$plan"
total=$(wc -l < "$plan" | tr -d ' ')
[ "$total" -gt 0 ] || { echo "error: no mutants${only:+ in files matching $only}" >&2; exit 1; }
[ "$jobs" -le "$total" ] || jobs=$total
echo "$total mutants in $jobs jobs" >&2

# The test targets of every entry run, once each.
targets=$(cut -f5 "$plan" | tr ',' '\n' | sort -u)
helper=$(dirname "$(xcrun --find swift)")/../libexec/swift/pm/swiftpm-testing-helper
[ -x "$helper" ] || { echo "error: no Swift Testing helper at $helper" >&2; exit 1; }
platform=$(xcrun --show-sdk-platform-path)/Developer
clear="$repo/.build/clear-windows.dylib"
if [ ! -e "$clear" ] || [ scripts/clear-windows.m -nt "$clear" ]; then
  clang -dynamiclib -fobjc-arc -framework AppKit -o "$clear" scripts/clear-windows.m
fi

# run_bundle <executable> <log> <seconds> — runs one test target's bundle, as scripts/test
# does, under a time limit of that many seconds, and prints `passed`, `failed` (it printed a
# failing summary), `crashed` (it started a run and never printed one), `timed out`, or `didn't
# run` (no run started: the tests never ran, so a failure says nothing about the mutant).
run_bundle() {
  local executable=$1 log=$2 limit=$3 runlog="$2.run" status=0 started failing
  # Perl runs the bundle in a child and kills it at the time limit, polling rather than
  # waiting on an alarm, which neither the test helper nor a perl blocked in waitpid is sure
  # to act on. It sets the DYLD_ variables itself, since /usr/bin/perl is protected by SIP,
  # which drops them from its environment.
  NO_COLOR=1 perl -MPOSIX=:sys_wait_h -e '
    @ENV{qw(DYLD_INSERT_LIBRARIES DYLD_FRAMEWORK_PATH DYLD_LIBRARY_PATH)} = splice @ARGV, 0, 3;
    my $limit = shift;
    my $pid = fork // die "fork: $!";
    if (!$pid) { exec @ARGV or die "exec: $!" }
    my $end = time + $limit;
    while (waitpid($pid, WNOHANG) == 0) {
      if (time >= $end) { kill "KILL", $pid; waitpid $pid, 0; exit 142 }
      select undef, undef, undef, 0.2;
    }
    exit($? & 127 ? 128 + ($? & 127) : $? >> 8)' -- \
    "$clear" "$platform/Library/Frameworks" "$platform/usr/lib" "$limit" \
    "$helper" --test-bundle-path "$executable" "$executable" --testing-library swift-testing \
    > "$runlog" 2>&1 || status=$?
  cat "$runlog" >> "$log"
  started=$(grep -c '^◇ Test run started\.$' "$runlog" || true)
  failing=$(grep -c '^✘ Test run with ' "$runlog" || true)
  rm -f "$runlog"
  if [ "$status" -eq 0 ]; then echo passed
  elif [ "$status" -eq 142 ]; then echo "timed out"
  elif [ "$started" -eq 0 ]; then echo "didn't run"
  elif [ "$failing" -gt 0 ]; then echo failed
  else echo crashed
  fi
}

# run_tests <bin> <log> <seconds> <comma-separated test targets> — runs each target's bundle
# until one doesn't pass, and prints how the last went, as run_bundle does. A bundle that
# fails is run once more and fails only when it fails again: on a loaded machine a test that
# waits on timing fails now and then.
run_tests() {
  local bin=$1 log=$2 limit=$3 target executable outcome=passed
  for target in ${4//,/ }; do
    executable=$bin/$target.xctest/Contents/MacOS/$target
    outcome=$(run_bundle "$executable" "$log" "$limit")
    [ "$outcome" != failed ] || outcome=$(run_bundle "$executable" "$log" "$limit")
    [ "$outcome" = passed ] || break
  done
  echo "$outcome"
}

stop="$out/stop"
rm -f "$stop"
run_job() {
  local job=$1 tree="$out/tree-$1" build="$out/build-$1" results="$out/results-$1.tsv"
  local log="$out/job-$1.log" bin product tests limit
  : > "$results"
  : > "$log"
  local flags=(--scratch-path "$build")
  for product in $targets; do
    (cd "$tree" && swift build "${flags[@]}" --product "$product" >> "$log" 2>&1) || {
      echo "error: job $job's unmutated build failed; see $log" >&2
      touch "$stop"
      return 1
    }
  done
  bin=$(cd "$tree" && swift build "${flags[@]}" --show-bin-path)
  # Each target's unmutated run sets the time limit of its mutants' runs: three times as
  # long, and at least 4 minutes, since a loaded machine runs the tests several times slower
  # than an idle one.
  local seconds="$out/seconds-$job" start
  : > "$seconds"
  tests=passed
  for product in $targets; do
    start=$SECONDS
    tests=$(run_tests "$bin" "$log" 1800 "$product")
    [ "$tests" = passed ] || break
    echo "$product $((SECONDS - start))" >> "$seconds"
  done
  if [ "$tests" != passed ]; then
    echo "error: job $job's unmutated tests $tests, so no mutant can be scored; see $log" >&2
    touch "$stop"
    return 1
  fi
  awk -v jobs="$jobs" -v job="$job" 'NR % jobs == job' "$plan" | while IFS=$'\t' read -r file id line summary target; do
    [ ! -e "$stop" ] || return 1
    local outcome
    (cd "$tree" && "$tool" apply "$file" "$id")
    local built=1
    for product in ${target//,/ }; do
      (cd "$tree" && swift build "${flags[@]}" --product "$product" >> "$log" 2>&1) \
        || { built=0; break; }
    done
    if [ "$built" -eq 0 ]; then
      outcome=uncompilable
    else
      limit=$(awk -v targets=",$target," 'index(targets, "," $1 ",") { sum += 3 * $2 }
        END { print (sum > 240 ? sum : 240) }' "$seconds")
      tests=$(run_tests "$bin" "$log" "$limit" "$target")
      case "$tests" in
        passed) outcome=survived ;;
        failed|crashed|"timed out") outcome=killed ;;
        *)
          echo "error: $file mutant $id (line $line): the tests $tests; see $log" >&2
          touch "$stop"
          git -C "$tree" checkout -q -- "$file"
          return 1 ;;
      esac
    fi
    git -C "$tree" checkout -q -- "$file"
    printf '%s\t%s\t%s\t%s\t%s\n' "$file" "$id" "$line" "$summary" "$outcome" >> "$results"
  done
}

# A run with fewer jobs than the last would otherwise score that run's results too.
rm -f "$out"/results-*.tsv
for job in $(seq 0 $((jobs - 1))); do
  tree="$out/tree-$job"
  git -C "$repo" worktree remove --force "$tree" 2> /dev/null || rm -rf "$tree"
  git -C "$repo" worktree add -q --detach "$tree" HEAD
  worktrees+=("$tree")
done
for job in $(seq 0 $((jobs - 1))); do
  run_job "$job" &
  pids+=($!)
done
failed=0
for pid in "${pids[@]}"; do wait "$pid" || failed=1; done
pids=()
cat "$out"/results-*.tsv | sort -t$'\t' -k1,1 -k2,2n > "$out/results.tsv"
[ "$failed" -eq 0 ] || { echo "error: a job failed" >&2; exit 1; }

awk -F'\t' '
  { files[$1] = 1; count[$1, $5]++ }
  $5 == "survived" { survivors[$1] = survivors[$1] "    line " $3 ": " $4 "\n" }
  END {
    for (file in files) {
      killed = count[file, "killed"] + 0; survived = count[file, "survived"] + 0
      scored = killed + survived
      printf "%s: %.1f%% (%d killed, %d survived, %d uncompilable)\n", file,
        scored ? 100 * killed / scored : 100, killed, survived, count[file, "uncompilable"] + 0
      printf "%s", survivors[file]
    }
  }' "$out/results.tsv"
