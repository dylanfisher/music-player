#!/usr/bin/env bash
# Fills a disk under each file the app writes and checks every failure is reported and changes
# nothing else (ADR 0023). Not part of ./scripts/check, since it attaches a disk image.
#   ./scripts/full-disk
# The image is attached at a mount point inside ~/Library/Caches/MusicPlayer, never under
# /Volumes, and on every exit detached and removed with its mount point. It scans and edits
# the library and clones scripts/drill-fixtures makes.
set -euo pipefail
cd "$(dirname "$0")/.."
[ $# -eq 0 ] || { echo "error: takes no arguments" >&2; exit 1; }

. scripts/drill-fixtures
. scripts/disk-image

caches="$HOME/Library/Caches/MusicPlayer"
attach_disk_image "$caches/full-disk.dmg" "$caches/full-disk" 16m MusicPlayerFullDisk
"$drill" full-disk --mount "$disk_mount" --scan "$fixtures" --tags "$tags"
