#!/usr/bin/env bash
# Run the app locally. The ONE place the run command is written down — AGENTS.md and
# README point here rather than repeating it. Extra args go to the app.
#
# Runs the binary inside the .app so Info.plist applies, in the foreground so logs land here.
set -euo pipefail
cd "$(dirname "$0")/.."

app="$(./scripts/bundle debug)"
exec "$app/Contents/MacOS/MusicPlayer" "$@"
