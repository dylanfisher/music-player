#!/usr/bin/env bash
# Builds the MusicPlayer executable and wraps it in a signed .app, so it runs with its
# Info.plist (bundle ID, minimum macOS, and later the usage strings). Prints the .app path.
#   ./scripts/bundle [debug|release]
# Release builds are universal, because they get copied to other Macs, including the
# Intel 2015 MacBook Pro. Debug builds are native only, for speed.
set -euo pipefail
cd "$(dirname "$0")/.."

config="${1:-debug}"
flags=(-c "$config")
[ "$config" = release ] && flags+=(--arch arm64 --arch x86_64)
swift build "${flags[@]}" --product MusicPlayer >&2
bin="$(swift build "${flags[@]}" --show-bin-path)"
app="$bin/MusicPlayer.app"

rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$bin/MusicPlayer" "$app/Contents/MacOS/"
cp Support/Info.plist "$app/Contents/"

# The deployment target is declared once, in Package.swift.
min_macos=$(swift package dump-package | python3 -I -c '
import json, sys
print(next(p["version"] for p in json.load(sys.stdin)["platforms"] if p["platformName"] == "macos"))')
/usr/libexec/PlistBuddy -c "Add :LSMinimumSystemVersion string $min_macos" "$app/Contents/Info.plist"

# The bundle ID is declared once, in Swift, because it's also the log subsystem.
bundle_id=$(sed -n 's/^public let bundleIdentifier = "\(.*\)"$/\1/p' Sources/Core/Log/ModuleLogger.swift)
if [ -z "$bundle_id" ]; then
  echo "couldn't read bundleIdentifier from Sources/Core/Log/ModuleLogger.swift" >&2; exit 1
fi
/usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $bundle_id" "$app/Contents/Info.plist"

# Ad-hoc signature for local runs. Release signing and notarization come later.
codesign --force --sign - "$app" >&2
echo "$app"
